APP_NAME="Skill Agent Loop Service"
# 数据库连接字符串（PostgreSQL）。
# 格式：postgresql+psycopg://<用户>:<密码>@<主机>:<端口>/<库名>
# 本地开发默认连接 Docker 启动的 staffdeck-postgres 容器。
# 生产环境务必改为带强密码的实际数据库地址。
DATABASE_URL="postgresql+psycopg://staffdeck:staffdeck123@localhost:5432/staffdeck"
# 启动时是否自动建表（create_all，幂等）+ 填充演示种子数据。
# - true（默认，开发/首次部署）：缺失的表会被创建，并写入演示数据。
# - false（生产稳定运行）：跳过建表与种子数据，schema 需由外部迁移工具管理。
# 注意：本开关只控制"建表"，不做 schema 演进（加字段/改类型不会生效）。
AUTO_INIT_DB="true"
APP_SECRET="change-me-in-development"
DEMO_MODEL_BASE_URL="http://58.57.119.12:52010/v1"
DEMO_MODEL_NAME="qwen3.6-27b"
DEMO_MODEL_API_KEY=""
MODEL_THINKING_MODE=""
MODEL_THINKING_MODELS=""
TOOL_TIMEOUT_SECONDS="8"
TOOL_BASE_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
GENERAL_SKILL_RUNTIME_PYTHON=""
GENERAL_SKILL_RUNTIME_VENV=""
GENERAL_SKILL_RUNTIME_PACKAGES="requests,httpx"
GENERAL_SKILL_RUNTIME_AUTO_INSTALL="true"
